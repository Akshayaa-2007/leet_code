class Solution:
    def searchInsert(self, nums: List[int], target: int) -> int:
        # for index,i in enumerate(nums):
        #     if(index==target):
                
        # return index
        for i in range(len(nums)):
            if nums[i]==target:
                return i
        for i in range(len(nums)):
            if nums[i]>=target:
                return i
        return len(nums)
