class Solution:
    def fourSumCount(self, nums1: List[int], nums2: List[int], nums3: List[int], nums4: List[int]) -> int:
        res={}
        count=0
        for i in nums1:
            for j in nums2:
                pair=i+j
                res[pair]=res.get(pair,0)+1
        for k in nums3:
            for l in nums4:
                target=-(k+l)
                if target in res:
                    count+=res[target]
        return count
