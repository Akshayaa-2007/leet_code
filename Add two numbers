class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        // 1. Create a fake "dummy" head node to easily build the new list
        ListNode dummyHead = new ListNode(0);
        ListNode current = dummyHead;
        int carry = 0; // Tracks the "carried over" tens place (e.g., 5 + 7 = 12, carry = 1)
        
        // 2. Loop until BOTH lists are empty AND there is no remaining carry
        while (l1 != null || l2 != null || carry != 0) {
            int sum = carry; // Start the sum with the previous column's carry
            
            // Add value from l1 if it exists, then move l1 to the next node
            if (l1 != null) {
                sum += l1.val;
                l1 = l1.next;
            }
            
            // Add value from l2 if it exists, then move l2 to the next node
            if (l2 != null) {
                sum += l2.val;
                l2 = l2.next;
            }
            
            // Calculate the new carry (either 0 or 1)
            carry = sum / 10;
            
            // Create a new node with the single digit (0-9) and link it
            current.next = new ListNode(sum % 10);
            
            // Move our pointer forward in the result list
            current = current.next;
        }
        
        // 3. Return the actual starting node (skipping the dummy 0)
        return dummyHead.next;
    }
}
