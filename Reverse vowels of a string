class Solution:
    def reverseVowels(self, s: str) -> str:
        s_list=list(s)
        vowels=set('aeiouAEIOU')
        left=0
        right=len(s)-1
        while left<right:
            if s[left] not in vowels:
                left+=1
            elif s[right] not in vowels:
                right-=1
            else:
                s_list[left],s_list[right]=s_list[right],s_list[left]
                left+=1
                right-=1
        return "".join(s_list)
